# Copy to .env (or set these in cPanel -> Setup Node.js App -> Environment variables)

# --- First login / dashboard ---
# Team accounts live in the dashboard (Team menu). On the FIRST run, logging in with these creates the first Super Admin.
# After that this password is no longer used (manage everyone from Dashboard -> Team).
# If it contains # or $ wrap it in quotes: ADMIN_PASSWORD='My#Pass$word1'
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_SECRET=put-a-long-random-string-here    # optional: signs login sessions (otherwise generated and stored in content/.secret)

# --- Site / SEO ---
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# SITE_INDEXING=off          # block all crawlers (staging only)

# --- Email (cPanel / Namecheap mailbox via SMTP). Set these ONLY in the server's environment variables, never commit the password ---
# SMTP_HOST=alanfaldoc.com            # (if the certificate is rejected, use the server name shown in cPanel > Email Accounts > Connect Devices)
# SMTP_PORT=465                       # 465 = SSL/TLS, 587 = STARTTLS
# SMTP_USER=info@alanfaldoc.com
# SMTP_PASS=
# MAIL_FROM="Al Anfal Doc <info@alanfaldoc.com>"
# LEAD_ALERT_EMAIL=info@alanfaldoc.com   # who receives new-ticket / new-chat alerts (comma separated)
# Alternative: an HTTP mail API (Resend, Postmark...): MAIL_API_URL=  MAIL_API_KEY=

# --- Live chat visitor location (optional) ---
# Cloudflare/Vercel country headers are used automatically. Otherwise point to a lookup URL containing {ip}:
# GEOIP_URL=https://ipapi.co/{ip}/json/

# --- Storage / misc (optional) ---
# CONTENT_DIR=/home/USER/alanfaldoc-content   # keep content outside the app folder so deployments never touch it
# NEXT_PUBLIC_FA_KIT=1b8091c28c
