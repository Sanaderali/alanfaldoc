# Copy to .env (or set these in cPanel -> Setup Node.js App -> Environment variables)

# --- Dashboard (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-password   # REQUIRED, min 8 chars. Dashboard is disabled without it
ADMIN_SECRET=put-a-long-random-string-here    # recommended: signs login sessions

# --- Site / SEO ---
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# SITE_INDEXING=off          # block all crawlers (staging only)

# --- Storage (optional) ---
# CONTENT_DIR=/home/USER/alanfaldoc-content   # keep content outside the app folder so deployments never touch it
# NEXT_PUBLIC_FA_KIT=1b8091c28c
