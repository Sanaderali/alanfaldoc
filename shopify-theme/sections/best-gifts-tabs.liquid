<section class="section section--lilac">
  <div class="container" data-tabs>
    <div class="section__head section__head--center">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    </div>

    <div class="tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" class="tabs__btn{% if forloop.first %} is-active{% endif %}" data-tab="{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
          {{ block.settings.label | default: block.settings.collection.title }}
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="tabpanel{% unless forloop.first %} is-hidden{% endunless %}" data-panel="{{ block.id }}" role="tabpanel">
        <div class="rail" data-rail>
          <button type="button" class="rail__btn rail__btn--prev" data-rail-prev aria-label="Previous">{% render 'icon', name: 'arrow-left' %}</button>
          <ul class="rail__track rail__track--cards">
            {%- for product in block.settings.collection.products limit: 8 -%}
              <li class="pcard-wrap">{% render 'product-card', product: product %}</li>
            {%- else -%}
              <li class="muted">—</li>
            {%- endfor -%}
          </ul>
          <button type="button" class="rail__btn rail__btn--next" data-rail-next aria-label="Next">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Best gifts (tabs)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best gifts" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Celebrate life's special moments with our bestsellers" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Flowers" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Best gifts (tabs)", "blocks": [{ "type": "tab" }, { "type": "tab" }] }
  ]
}
{% endschema %}
