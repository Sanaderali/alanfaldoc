<section class="usp">
  <div class="container usp__grid">
    {%- for block in section.blocks -%}
      <div class="usp__item" {{ block.shopify_attributes }}>
        <span class="usp__icon">{% render 'icon', name: block.settings.icon %}</span>
        <div>
          <b>{{ block.settings.title }}</b>
          <small>{{ block.settings.text }}</small>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Benefits bar",
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "gift", "label": "Gift" },
            { "value": "clock", "label": "Clock" },
            { "value": "card", "label": "Card" },
            { "value": "heart", "label": "Heart" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Same-day delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Pick your time window" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Same-day delivery", "text": "Pick your time window" } },
        { "type": "item", "settings": { "icon": "gift", "title": "Wrapped with love", "text": "Free gift card message" } },
        { "type": "item", "settings": { "icon": "card", "title": "Pay on delivery", "text": "Cash on delivery available" } },
        { "type": "item", "settings": { "icon": "clock", "title": "Live till late", "text": "Slots until 9 PM" } }
      ]
    }
  ]
}
{% endschema %}
