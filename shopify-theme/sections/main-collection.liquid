{%- paginate collection.products by 24 -%}
<section class="section">
  <div class="container">
    <header class="pagehead">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte muted">{{ collection.description }}</div>
      {%- endif -%}
      <p class="muted">{{ 'collection.products' | t: count: collection.products_count }}</p>
    </header>

    <form class="toolbar" method="get" data-autosubmit>
      {%- if collection.filters.size > 0 -%}
        <div class="toolbar__filters">
          {%- for filter in collection.filters -%}
            <details class="fgroup">
              <summary>{{ filter.label }} {% render 'icon', name: 'chevron' %}</summary>
              <div class="fgroup__panel">
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    <label class="field"><span class="field__label">{{ 'collection.price_from' | t }}</span>
                      <input type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}" inputmode="numeric">
                    </label>
                    <label class="field"><span class="field__label">{{ 'collection.price_to' | t }}</span>
                      <input type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}" inputmode="numeric">
                    </label>
                  {%- else -%}
                    {%- for value in filter.values -%}
                      <label class="check">
                        <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                        <span>{{ value.label }} <small>({{ value.count }})</small></span>
                      </label>
                    {%- endfor -%}
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
          {%- if collection.filters.size > 0 and collection.current_vendor == blank -%}
            <a class="link-arrow" href="{{ collection.url }}?sort_by={{ collection.sort_by }}">{{ 'collection.clear' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <label class="field field--inline">
        <span class="field__label">{{ 'collection.sort_by' | t }}</span>
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <select name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
      <noscript><button class="btn btn--primary btn--sm" type="submit">{{ 'collection.apply' | t }}</button></noscript>
    </form>

    {%- if collection.products.size == 0 -%}
      <p class="empty">{{ 'collection.no_products' | t }}</p>
    {%- else -%}
      <ul class="grid">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection page"
}
{% endschema %}
