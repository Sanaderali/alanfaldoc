<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {% style %}
      :root {
        --c-ink: {{ settings.color_ink }};
        --c-primary: {{ settings.color_primary }};
        --c-accent: {{ settings.color_accent }};
        --c-sun: {{ settings.color_sun }};
        --c-bg: {{ settings.color_bg }};
        --c-soft: {{ settings.color_soft }};
        --c-mint: {{ settings.color_mint }};
        --radius: {{ settings.radius }}px;
      }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main class="password">
      <div class="logo logo--big"><span>Gift</span><b>Yalla!</b></div>
      <h1>{{ 'general.password_title' | t }}</h1>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <div class="field-row">
          <input type="password" name="password" placeholder="{{ 'general.password' | t }}" required>
          <button class="btn btn--primary" type="submit">{{ 'general.enter' | t }}</button>
        </div>
      {% endform %}
    </main>
    {{ content_for_layout }}
  </body>
</html>
