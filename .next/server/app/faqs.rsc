17:Tc07,[{"@context":"https://schema.org","@type":["ProfessionalService","LocalBusiness"],"@id":"https://alanfaldoc.com/#organization","name":"Al Anfal Doc","legalName":"Al Anfal Documents Clearing Services LLC","url":"https://alanfaldoc.com/","description":"Dubai company formation, trade licence renewal, government approvals, document attestation and visa application support for business owners, investors and expatriates.","logo":"https://alanfaldoc.com/logo-black.png","image":"https://alanfaldoc.com/logo-black.png","telephone":"+971 50 805 1192","email":"info@alanfaldoc.com","address":{"@type":"PostalAddress","streetAddress":"Dubai, UAE","addressLocality":"Dubai","addressRegion":"Dubai","addressCountry":"AE"},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"09:00","closes":"18:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":["Saturday"],"opens":"08:30","closes":"15:30"}],"areaServed":[{"@type":"Place","name":"United Arab Emirates"},{"@type":"Place","name":"Dubai"},{"@type":"Place","name":"Abu Dhabi"},{"@type":"Place","name":"Sharjah"}],"contactPoint":[{"@type":"ContactPoint","contactType":"customer service","telephone":"+971 50 805 1192","email":"info@alanfaldoc.com","areaServed":"AE","availableLanguage":["English","Arabic"]}],"sameAs":[],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Al Anfal Doc Services","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Company Formation","url":"https://alanfaldoc.com/services/company-formation"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"PRO Services","url":"https://alanfaldoc.com/services/pro-services"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Visa Processing","url":"https://alanfaldoc.com/services/visa-processing"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Document Clearing","url":"https://alanfaldoc.com/services/document-clearing"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Trade License","url":"https://alanfaldoc.com/services/trade-license"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Legal Translation","url":"https://alanfaldoc.com/services/legal-translation"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Bank Account Opening","url":"https://alanfaldoc.com/services/bank-account-opening"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Business Consulting","url":"https://alanfaldoc.com/services/business-consulting"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Business Immigration","url":"https://alanfaldoc.com/services/business-immigration"}}]}},{"@context":"https://schema.org","@type":"WebSite","@id":"https://alanfaldoc.com/#website","url":"https://alanfaldoc.com/","name":"Al Anfal Doc","description":"Dubai company formation, trade licence renewal, government approvals, document attestation and visa application support for business owners, investors and expatriates.","inLanguage":"en","publisher":{"@id":"https://alanfaldoc.com/#organization"}}]8:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],["$","a",null,{"href":"#main","className":"sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:rounded","children":"Skip to content"}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]
