25:["$","div","Bank Account Opening",{"className":"reveal reveal-up break-inside-avoid mb-10","children":[["$","h2",null,{"id":"bank-account-opening","className":"text-xl sm:text-2xl font-bold text-brand-text mb-5 scroll-mt-24","children":"Bank Account Opening"}],["$","$L1b",null,{"faqs":[{"question":"Can you guarantee my bank account will be approved?","answer":"No. Banks make their own compliance decisions. We prepare a complete application and introduce you to banks that fit your profile to improve your chances."},{"question":"What documents are needed to open a corporate account?","answer":"Typically the trade licence, memorandum of association, shareholder and manager IDs, proof of address and a business profile. Requirements vary by bank."},{"question":"Do I need to be in the UAE to open an account?","answer":"Some banks require an in-person visit and others support remote steps. We confirm the process for your chosen bank."}],"defaultOpen":null}],["$","p",null,{"className":"mt-3 text-sm","children":["$","$Lc",null,{"prefetch":false,"href":"/services/bank-account-opening","className":"font-semibold text-brand-text hover:underline","children":["Read the full ","Bank Account Opening"," page →"]}]}]]}]
26:["$","div","Business Consulting",{"className":"reveal reveal-up break-inside-avoid mb-10","children":[["$","h2",null,{"id":"business-consulting","className":"text-xl sm:text-2xl font-bold text-brand-text mb-5 scroll-mt-24","children":"Business Consulting"}],["$","$L1b",null,{"faqs":[{"question":"Who is business consulting for?","answer":"Founders, investors and established companies that need guidance on structure, compliance or entering the UAE market."},{"question":"Do you give legal or tax advice?","answer":"We provide practical business and regulatory guidance. For formal legal or tax opinions we recommend a licensed adviser and can coordinate with one."},{"question":"How do I get started?","answer":"Book a consultation and tell us your goals. We recommend the best structure and the next steps."}],"defaultOpen":null}],["$","p",null,{"className":"mt-3 text-sm","children":["$","$Lc",null,{"prefetch":false,"href":"/services/business-consulting","className":"font-semibold text-brand-text hover:underline","children":["Read the full ","Business Consulting"," page →"]}]}]]}]
27:["$","div","Business Immigration",{"className":"reveal reveal-up break-inside-avoid mb-10","children":[["$","h2",null,{"id":"business-immigration","className":"text-xl sm:text-2xl font-bold text-brand-text mb-5 scroll-mt-24","children":"Business Immigration"}],["$","$L1b",null,{"faqs":[{"question":"What is the UAE golden visa?","answer":"A long-term residence visa for eligible investors, entrepreneurs and skilled professionals. Eligibility depends on the category and current rules."},{"question":"Can I get residence as a company owner?","answer":"Yes, owners and partners of a UAE company can usually apply for residence linked to the company. Requirements depend on the licence type."},{"question":"Can my family be included?","answer":"Eligible residents can generally sponsor family members. We prepare the documentation for each sponsored person."}],"defaultOpen":null}],["$","p",null,{"className":"mt-3 text-sm","children":["$","$Lc",null,{"prefetch":false,"href":"/services/business-immigration","className":"font-semibold text-brand-text hover:underline","children":["Read the full ","Business Immigration"," page →"]}]}]]}]
