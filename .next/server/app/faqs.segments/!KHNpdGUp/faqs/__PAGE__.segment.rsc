d:T2700,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which payment methods do you accept?","acceptedAnswer":{"@type":"Answer","text":"We accept bank transfer, major credit and debit cards and online payment links. We confirm fees in writing before we start."}},{"@type":"Question","name":"What is the registration process?","acceptedAnswer":{"@type":"Answer","text":"It starts with a consultation, then we collect and check your documents, submit them to the authorities and keep you updated until approval."}},{"@type":"Question","name":"How can I update my personal information?","acceptedAnswer":{"@type":"Answer","text":"Send us the updated details through the contact page or by email and we will update your file."}},{"@type":"Question","name":"Can I own 100% of my company?","acceptedAnswer":{"@type":"Answer","text":"In most activities, yes. We confirm eligibility for your activity and jurisdiction first."}},{"@type":"Question","name":"Mainland or free zone, which is better?","acceptedAnswer":{"@type":"Answer","text":"It depends on where your customers are and what you need to trade. We compare both against your plan."}},{"@type":"Question","name":"How long does it take to get a trade licence?","acceptedAnswer":{"@type":"Answer","text":"It varies by jurisdiction and activity. We give you a realistic timeline after reviewing your file."}},{"@type":"Question","name":"Do you guarantee a visa approval?","acceptedAnswer":{"@type":"Answer","text":"No. Decisions are made by the authorities. We prepare a complete, correct application to avoid delays and avoidable rejections."}},{"@type":"Question","name":"How long does the application process take?","acceptedAnswer":{"@type":"Answer","text":"It depends on the visa type and authority. We estimate after reviewing your documents."}},{"@type":"Question","name":"Can you help my family with their visas?","acceptedAnswer":{"@type":"Answer","text":"Yes. We prepare the documents for sponsored family members too."}},{"@type":"Question","name":"What is document attestation?","acceptedAnswer":{"@type":"Answer","text":"Official verification of a document by the relevant authorities so it is accepted in another country."}},{"@type":"Question","name":"Do you provide certified translation?","acceptedAnswer":{"@type":"Answer","text":"Yes. Arabic and English are most common and other languages are available on request."}},{"@type":"Question","name":"Is express service available?","acceptedAnswer":{"@type":"Answer","text":"For many document types, yes. Timing depends on the authority involved."}},{"@type":"Question","name":"Can a foreigner own 100% of a company in the UAE?","acceptedAnswer":{"@type":"Answer","text":"In most business activities, yes. Ownership rules depend on your activity and jurisdiction (mainland or free zone). We confirm eligibility for your specific activity before you commit."}},{"@type":"Question","name":"What is the difference between a mainland and a free zone company?","acceptedAnswer":{"@type":"Answer","text":"A mainland licence lets you trade across the UAE and with government entities, while a free zone licence offers a simpler setup and is usually limited to trading within the zone or internationally. We compare both against your business plan."}},{"@type":"Question","name":"How long does company formation take?","acceptedAnswer":{"@type":"Answer","text":"Timelines depend on the jurisdiction, the activity and how quickly documents are provided. After reviewing your file we give you a realistic timeline."}},{"@type":"Question","name":"Do I need a physical office?","acceptedAnswer":{"@type":"Answer","text":"Most licences require registered office space, but the type (flexi-desk, shared or dedicated) depends on the jurisdiction and activity. We advise on the lowest-cost compliant option."}},{"@type":"Question","name":"What does a PRO service do?","acceptedAnswer":{"@type":"Answer","text":"A PRO (Public Relations Officer) handles government paperwork on your behalf: visas, labour cards, licence renewals, approvals and attestations, so you do not have to queue at government offices."}},{"@type":"Question","name":"Which government departments do you deal with?","acceptedAnswer":{"@type":"Answer","text":"We handle transactions with immigration, labour, free zone authorities, municipalities, chambers of commerce and other UAE entities."}},{"@type":"Question","name":"Can you manage renewals for me?","acceptedAnswer":{"@type":"Answer","text":"Yes. We track expiry dates for licences, visas and cards and renew them ahead of time to avoid fines."}},{"@type":"Question","name":"Which visas can you help with?","acceptedAnswer":{"@type":"Answer","text":"Employment, investor, family sponsorship, tourist and golden visa applications, as well as renewals and cancellations."}},{"@type":"Question","name":"Do you guarantee a visa approval?","acceptedAnswer":{"@type":"Answer","text":"No. Decisions are made by the authorities. What we do is prepare a complete, correct application, which reduces delays and avoidable rejections."}},{"@type":"Question","name":"How long does a visa application take?","acceptedAnswer":{"@type":"Answer","text":"Processing time depends on the visa type and the authority. We give you an estimate after reviewing your documents and keep you updated until a decision."}},{"@type":"Question","name":"What documents are usually required?","acceptedAnswer":{"@type":"Answer","text":"A valid passport, photo and supporting documents that vary by visa type, such as a sponsor or company file and a medical fitness result. We send you a checklist for your case."}},{"@type":"Question","name":"What is document attestation?","acceptedAnswer":{"@type":"Answer","text":"Attestation is the official verification of a document by the relevant authorities so it is accepted in another country, for example certificates, contracts or powers of attorney for use in the UAE."}},{"@type":"Question","name":"Which documents can you clear?","acceptedAnswer":{"@type":"Answer","text":"Educational, personal (marriage, birth) and commercial documents, powers of attorney and agreements. Contact us with your document and destination and we will confirm the steps."}},{"@type":"Question","name":"Do you offer express service?","acceptedAnswer":{"@type":"Answer","text":"Express options are available for many document types. Availability and timing depend on the authority involved."}},{"@type":"Question","name":"What types of trade licence are there?","acceptedAnswer":{"@type":"Answer","text":"Commercial, professional, industrial and tourism licences are the main categories. The right one depends on your business activity."}},{"@type":"Question","name":"When should I renew my trade licence?","acceptedAnswer":{"@type":"Answer","text":"Renew before the expiry date to avoid fines. We send reminders and handle the renewal for you."}},{"@type":"Question","name":"Can I add a new activity to my licence?","acceptedAnswer":{"@type":"Answer","text":"In many cases yes, through an amendment. Approvals and fees depend on the authority. We check feasibility first."}},{"@type":"Question","name":"What is a certified legal translation?","acceptedAnswer":{"@type":"Answer","text":"A translation prepared by an approved translator and stamped as an accurate rendering, accepted by courts and government bodies."}},{"@type":"Question","name":"Which languages do you translate?","acceptedAnswer":{"@type":"Answer","text":"Arabic and English are the most common pairs, with other languages available on request."}},{"@type":"Question","name":"Can you translate and attest in one go?","acceptedAnswer":{"@type":"Answer","text":"Yes. We can handle the translation and the follow-on notarisation or attestation as one service."}},{"@type":"Question","name":"Can you guarantee my bank account will be approved?","acceptedAnswer":{"@type":"Answer","text":"No. Banks make their own compliance decisions. We prepare a complete application and introduce you to banks that fit your profile to improve your chances."}},{"@type":"Question","name":"What documents are needed to open a corporate account?","acceptedAnswer":{"@type":"Answer","text":"Typically the trade licence, memorandum of association, shareholder and manager IDs, proof of address and a business profile. Requirements vary by bank."}},{"@type":"Question","name":"Do I need to be in the UAE to open an account?","acceptedAnswer":{"@type":"Answer","text":"Some banks require an in-person visit and others support remote steps. We confirm the process for your chosen bank."}},{"@type":"Question","name":"Who is business consulting for?","acceptedAnswer":{"@type":"Answer","text":"Founders, investors and established companies that need guidance on structure, compliance or entering the UAE market."}},{"@type":"Question","name":"Do you give legal or tax advice?","acceptedAnswer":{"@type":"Answer","text":"We provide practical business and regulatory guidance. For formal legal or tax opinions we recommend a licensed adviser and can coordinate with one."}},{"@type":"Question","name":"How do I get started?","acceptedAnswer":{"@type":"Answer","text":"Book a consultation and tell us your goals. We recommend the best structure and the next steps."}},{"@type":"Question","name":"What is the UAE golden visa?","acceptedAnswer":{"@type":"Answer","text":"A long-term residence visa for eligible investors, entrepreneurs and skilled professionals. Eligibility depends on the category and current rules."}},{"@type":"Question","name":"Can I get residence as a company owner?","acceptedAnswer":{"@type":"Answer","text":"Yes, owners and partners of a UAE company can usually apply for residence linked to the company. Requirements depend on the licence type."}},{"@type":"Question","name":"Can my family be included?","acceptedAnswer":{"@type":"Answer","text":"Eligible residents can generally sponsor family members. We prepare the documentation for each sponsored person."}}]}9:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$3","c",{"children":[[["$","nav",null,{"aria-label":"Breadcrumb","className":"bg-brand text-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://alanfaldoc.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"FAQs\"}]}"}}],["$","ol",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center gap-x-2 text-sm","children":[["$","li","0",{"className":"flex items-center gap-2","children":[false,["$","$Lc",null,{"prefetch":false,"href":"/","className":"inline-block py-2 text-white/90 hover:text-white hover:underline transition-colors","children":"[ Home ]"}]]}],["$","li","1",{"className":"flex items-center gap-2","children":[["$","span",null,{"aria-hidden":"true","className":"text-white/60","children":"»"}],["$","span",null,{"aria-current":"page","children":"FAQs"}]]}]]}]]}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],null,"$Le","$Lf"],null,"$L10"]}],"p":"$@11","v":null,"s":"$8"}}]]
