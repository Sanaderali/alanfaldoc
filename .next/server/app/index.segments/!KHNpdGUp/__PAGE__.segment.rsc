10:["$","section",null,{"className":"py-16 md:py-20 bg-white","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","div",null,{"className":"text-center mb-12","children":[["$","h2",null,{"className":"text-3xl md:text-4xl font-bold text-ink mb-4","children":"Have Questions? Look Here"}],["$","p",null,{"className":"text-gray-600","children":"Straight answers to the questions we hear most. If yours is not here, our team will be happy to help."}]]}],["$","$L2f",null,{"faqs":[{"question":"How do I pay for your services?","answer":"Your written quote lists our professional fee and the government fees separately, together with the payment options available for that quote. Government fees are charged in UAE dirhams at the amount the authority sets."},{"question":"What is the process once I contact you?","answer":"We review what you need, confirm the steps, documents and fees in writing, prepare and check your file, submit it to the right authority and follow it until the authority issues its decision. You receive copies of every submission."},{"question":"Can I update my details or cancel a request?","answer":"Contact our team and we will tell you what can be changed at the stage your file has reached. Once an authority has received an application, changes and refunds depend on that authority's rules."},{"question":"Can you guarantee that my application will be approved?","answer":"No. Every decision is made by the relevant UAE authority. We prepare complete and correct files and follow them up, which reduces avoidable rejections, but approval is never ours to promise."},{"question":"How long does company setup or a licence renewal take?","answer":"It depends on the activity, the premises and the authority's review. A simple renewal can take a few working days, while a new company with approvals can take several weeks. We give you an estimate for your case before work starts."}]}],["$","div",null,{"className":"text-center mt-8","